# Optional. Defaults to ~/.chatgpt-claude-orchestrator
ORCH_HOME=/home/codespace/.chatgpt-claude-orchestrator

# Local Claude Code executable or absolute path.
ORCH_CLAUDE_BIN=claude

# Optional Claude model alias or full model ID. Empty uses the local default.
# ORCH_CLAUDE_MODEL=sonnet

# Only acceptEdits and dontAsk are accepted. Other values fall back to acceptEdits.
ORCH_PERMISSION_MODE=acceptEdits

# Per-delegation limits.
ORCH_MAX_TURNS=12
ORCH_MAX_BUDGET_USD=3.00
ORCH_CLAUDE_TIMEOUT_MINUTES=45

# Per-check limit and captured output cap.
ORCH_CHECK_TIMEOUT_MINUTES=15
ORCH_MAX_OUTPUT_CHARS=120000
