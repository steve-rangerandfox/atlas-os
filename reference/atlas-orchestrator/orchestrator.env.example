# Optional. Defaults to ~/.atlas-orchestrator
ORCH_HOME=/home/codespace/.atlas-orchestrator

# Local executor binaries or absolute paths.
ORCH_CLAUDE_BIN=claude
ORCH_CODEX_BIN=codex

# Optional model aliases or full model IDs. Empty uses each local default.
# ORCH_CLAUDE_MODEL=sonnet
# ORCH_CODEX_MODEL=gpt-5.3-codex

# Only acceptEdits and dontAsk are accepted for Claude executor sessions.
# Other values fall back to acceptEdits.
ORCH_PERMISSION_MODE=acceptEdits

# Per-delegation limits.
ORCH_MAX_TURNS=12
ORCH_MAX_BUDGET_USD=3.00
ORCH_CLAUDE_TIMEOUT_MINUTES=45
ORCH_CODEX_TIMEOUT_MINUTES=45

# Controller identity is normally injected by install-controllers.sh.
# Valid values: claude, codex. Same-provider recursion is blocked by default.
# ORCH_CONTROLLER_PROVIDER=codex
# ORCH_ALLOW_SAME_PROVIDER_EXECUTOR=0

# Per-check limit and captured output cap.
ORCH_CHECK_TIMEOUT_MINUTES=15
ORCH_MAX_OUTPUT_CHARS=120000

# install-controllers.sh persists only the non-secret ORCH_* settings listed
# above. Never put credentials or API keys in this file.
