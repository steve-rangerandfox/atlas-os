{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-os/schemas/mission.schema.json",
  "title": "Atlas mission contract",
  "description": "Drafted by Mission Control / Mission Author into .atlas/proposals/. Promoted to .atlas/missions/ by a human.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "class", "state", "premise", "outcome", "acceptanceCriteria", "nonGoals", "scope", "evidencePlan", "rollback"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string" },
    "class": { "enum": ["express", "standard", "guarded"] },
    "type": { "enum": ["engineering", "evidence", "documentation"], "default": "engineering" },
    "state": {
      "enum": ["draft", "ready", "active", "implementing", "validating", "in_review", "correcting",
               "awaiting_gate", "accepted", "blocked", "deferred", "abandoned", "superseded",
               "invalidated_by_audit", "rolled_back"],
      "description": "Terminal and side states are first-class. A mission whose premise an audit disproves goes to invalidated_by_audit, not forward."
    },
    "premise": { "type": "string", "description": "The falsifiable belief this mission rests on. If an audit disproves it, the mission is invalid." },
    "outcome": { "type": "string", "description": "Implementation-neutral. What becomes true." },
    "currentProblem": { "type": "string" },
    "acceptanceCriteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "criterion", "observable"],
        "properties": {
          "id": { "type": "string" },
          "criterion": { "type": "string" },
          "observable": { "type": "string", "description": "What can be observed to prove this. A criterion with no observable is not testable and must not ship." },
          "acceptanceTest": { "type": "string", "description": "Path::testName, filled in by the Acceptance Engineer." },
          "status": { "enum": ["unwritten", "red", "green", "unproven", "refuted"], "default": "unwritten" }
        }
      }
    },
    "nonGoals": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "invariantsAtStake": { "type": "array", "items": { "type": "string" } },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["allowWrite"],
      "properties": {
        "allowWrite": { "type": "array", "items": { "type": "string" }, "minItems": 1,
          "description": "Glob allowlist. The policy guard denies writes outside this. Narrow is the point." },
        "expectedDirty": { "type": "array", "items": { "type": "string" },
          "description": "Paths expected to be modified but uncommitted. Distinguishes 'clean or expected-modified' from 'unchecked'." }
      }
    },
    "evidencePlan": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["observable", "producedBy"],
        "properties": {
          "observable": { "type": "string" },
          "producedBy": { "enum": ["atlas_validation", "ci", "human", "production_probe", "external_system"] },
          "notes": { "type": "string" }
        }
      }
    },
    "rollback": { "type": "string", "description": "How this is undone. Guarded missions must have a rehearsed answer." },
    "interruptionBudget": { "type": "integer", "minimum": 0, "description": "Expected human gates. Exceeding it is a tracked defect of Atlas, not of the mission." },
    "dependsOn": { "type": "array", "items": { "type": "string" } },
    "blockedBy": { "type": "array", "items": { "type": "string" } },
    "supersedes": { "type": "string" },
    "links": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "issue": { "type": "string" }, "pr": { "type": "string" },
        "branch": { "type": "string" }, "baseCommit": { "type": "string" },
        "expectedHead": { "type": "string", "description": "Distinct from baseCommit. baseCommit is the immutable review baseline; expectedHead advances when Atlas or a human commits." }
      }
    }
  }
}
